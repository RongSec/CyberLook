# ---------- 后端构建 ----------
FROM golang:1.26-alpine AS go-builder
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN go build -trimpath -ldflags="-s -w -X asset-platform/internal/version.Version=${VERSION#v}" -o /out/scope-agent ./cmd/agent

# ---------- 运行时 ----------
FROM debian:bookworm-slim
# 运行期只需要 CA 根证书（扫 https 用），直接从构建阶段复制，不再跑 apt：
# apt 源对国内网络经常握手失败/极慢，一次失败就让整次构建废掉，而这个镜像
# 本来只需要一个 200KB 的证书文件。时区由 Go 内嵌的 time/tzdata 提供
# （见 cmd/agent/main.go），不依赖系统 tzdata 包。
COPY --from=go-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV TZ=Asia/Shanghai
WORKDIR /app

# v0.0.27：扫描引擎已内置于 scope-agent（纯 Go 自研），不再打包 TscanClient。
# 审计库 = exe 同目录 config/config.db（/app/config），compose 卷 agent-engine-config
# 挂在 /app/config 上持久化（v0.0.27.1 卷名由 agent-tscan-config 改为 agent-engine-config，
# 旧卷不自动迁移，见 docker-compose.yml 的迁移命令）。
COPY --from=go-builder /out/scope-agent /app/scope-agent
# v0.0.27：全量指纹规则随镜像内置（约 11MB）。节点离线/换环境也能做服务识别；
# 缺了它不会报错，只会**沉默降级为纯端口扫描**（日志「规则载入失败，仅做端口扫描」），
# 所以这里是硬要求，不是可选优化。SCAN_RULES_DIR 与 scanner.BuiltinRulesDir() 对齐。
COPY data/fingerprint /app/data/fingerprint
ENV SCAN_RULES_DIR=/app/data/fingerprint
RUN mkdir -p /app/config && chmod +x /app/scope-agent

CMD ["/app/scope-agent", "-server", "http://server:8080", "-name", "node-docker"]

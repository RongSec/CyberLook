# ---------- 后端构建 ----------
FROM golang:1.26-alpine AS go-builder
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN go build -trimpath -ldflags="-s -w -X asset-platform/internal/version.Version=${VERSION#v}" -o /out/scope-agent ./cmd/agent

# ---------- 运行时 ----------
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai
WORKDIR /app

COPY --from=go-builder /out/scope-agent /app/scope-agent
# TscanClient 可选（仓库不提交二进制）
COPY third_party/ /app/third_party/
RUN mkdir -p /app/tscanclient && \
    if [ -f /app/third_party/tscanclient_linux/TscanClient_Linux_Amd64 ]; then \
        cp /app/third_party/tscanclient_linux/TscanClient_Linux_Amd64 /app/tscanclient/TscanClient; \
    fi && \
    chmod +x /app/tscanclient/TscanClient 2>/dev/null; \
    true

CMD ["/app/scope-agent", "-server", "http://server:8080", "-name", "node-docker", "-tscan", "/app/tscanclient/TscanClient"]

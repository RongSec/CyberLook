# ---------- 后端构建 ----------
FROM golang:1.26-alpine AS go-builder
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN go build -trimpath -ldflags="-s -w -X asset-platform/internal/version.Version=${VERSION#v}" -o /out/scope-agent ./cmd/agent

# ---------- 运行时 ----------
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai
WORKDIR /app

# v0.0.27：扫描引擎已内置于 scope-agent（纯 Go 自研），不再打包 TscanClient。
# 审计库 = exe 同目录 config/config.db（/app/config），compose 卷 agent-tscan-config
# 挂在 /app/config 上持久化（原卷名保留，挂载点从 /app/tscanclient/config 改名为语义正确的 /app/config）。
COPY --from=go-builder /out/scope-agent /app/scope-agent
RUN mkdir -p /app/config && chmod +x /app/scope-agent

CMD ["/app/scope-agent", "-server", "http://server:8080", "-name", "node-docker"]

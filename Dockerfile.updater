# 基础镜像可替换（内网私有源）：--build-arg GO_IMAGE=... / DOCKER_IMAGE=...
ARG GO_IMAGE=golang:1.26-alpine
ARG DOCKER_IMAGE=docker:27-cli

# updater 边车镜像：内置 docker CLI + 更新逻辑
FROM ${GO_IMAGE} AS builder
# 与 Dockerfile 保持一致：不加这个，境外的 proxy.golang.org 会卡在 go mod download
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# VERSION 由 compose/CI 传入，避免与主镜像版本脱节；与 Dockerfile 同样的注入方式。
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X asset-platform/internal/version.Version=${VERSION#v}" -o /out/updater ./cmd/updater

FROM ${DOCKER_IMAGE}
RUN apk add --no-cache curl tzdata
ENV TZ=Asia/Shanghai
COPY --from=builder /out/updater /usr/local/bin/updater
WORKDIR /project
EXPOSE 9999
CMD ["updater"]

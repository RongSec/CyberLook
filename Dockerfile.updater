# updater 边车镜像：内置 docker CLI + 更新逻辑
FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/updater ./cmd/updater

FROM docker:27-cli
RUN apk add --no-cache curl tzdata
ENV TZ=Asia/Shanghai
COPY --from=builder /out/updater /usr/local/bin/updater
WORKDIR /project
EXPOSE 9999
CMD ["updater"]

HOST_PROJECT_DIR=
COMPOSE_PROJECT_NAME=asset-platform
# 镜像版本（更新时由 updater 自动改写；init.sh 首次部署会拉取最新 release）
APP_VERSION=v0.0.15

# 此文件仅作示例。部署时运行 bash init.sh 会自动生成 .env（含随机密码）
# PostgreSQL 密码
POSTGRES_PASSWORD=your-strong-password

# JWT 密钥（留空则自动生成）
# JWT_SECRET=

# ===== AI 助手（LLM）=====
# OpenAI 兼容接口地址，留空则关闭 AI 助手功能
# 本地 LLM 示例: http://192.168.1.100:8000/v1
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5-32b-instruct

# 未见 · 配置模板
#
# 这个文件是模板，不含任何真实密钥，可以随仓库分发。
# 首次部署时 init.sh / init.ps1 会用它生成 .env（.env 已加入 .gitignore，不会入库）。
# 也可以手工复制：cp .env.example .env
#
# ⚠️ 不要把任何真实密钥写进 .env 后提交。LLM 的 API Key 请在
#    「系统配置 → LLM 配置」界面里填，会存进数据库，不需要落在 .env 里。

# ---------- 基础 ----------
COMPOSE_PROJECT_NAME=asset-platform
# 部署目录的绝对路径，由 init 脚本自动填写；updater 靠它与宿主机路径对齐
HOST_PROJECT_DIR=

# 镜像版本（更新时由 updater 自动改写；init 脚本首次部署会拉取最新 release）
# 每次执行 init.sh 都会跟随最新正式版（只升不降）。
APP_VERSION=
# 想锁死某个版本不被 init.sh 改动，取消下一行注释。锁版本后升级需手工改 APP_VERSION。
# PIN_VERSION=1

# PostgreSQL 密码：init 脚本会生成 24 位随机值，不需要你填
POSTGRES_PASSWORD=

# Web 端口（宿主）。改了这里，init 脚本的健康检查会跟着改，不用动别处。
# HOST_PORT=18888

# JWT 密钥：留空即可。服务端首次启动会生成 32 字节随机值并持久化到
# data/files/jwt.secret（该目录已在 .gitignore 里）
# JWT_SECRET=

# ---------- 镜像源 ----------
# 默认 Docker Hub：docker.io/rongsec
# 内网自建 harbor 时改这里（需先把三个镜像同步过去）
# REGISTRY=harbor.example.com/library

# ---------- 可选：LLM 初始默认值 ----------
# 留空即可，界面里配更安全。这里只用于「数据库里还没有配置时」的兜底展示。
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ---------- 可选：资源与并发 ----------
# 平台侧预留核数（默认 4 核留 1、8 核及以上留 2；设 0 表示独占机器）
# CPU_RESERVE_CORES=
# 扫描节点侧预留核数
# SCAN_CPU_RESERVE_CORES=
# 存活探测并发上限
# ALIVE_PROBE_CONCURRENCY=
# AI 识别作业并发（默认约 核数/2，上限 3；界面「LLM 配置」也能改）
# AI_IDENT_CONCURRENCY=
